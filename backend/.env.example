MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC=smokelens/+/data
HTTP_PORT=3000
NODE_TIMEOUT_MS=30000

# Fixed node locations for the dashboard map.
# Replace lat/lng with the deployment area.
NODE_LOCATIONS_JSON={"node_01":{"name":"Node 01","lat":25.02171637333861,"lng":121.53665177465513,"radius_m":80}}

# Optional. If omitted, the backend stores data at ../data/smokelens.csv.
# CSV_PATH=../data/smokelens.csv

# Optional. Defaults to ../ml/models/smokelens_linear.json from the repo root.
# MODEL_PATH=../ml/models/smokelens_linear.json
