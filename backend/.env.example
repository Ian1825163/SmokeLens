MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC=smokelens/+/data
HTTP_PORT=3000
NODE_TIMEOUT_MS=30000

# Cloud MQTT example:
# MQTT_URL=mqtts://your-cluster.s1.eu.hivemq.cloud:8883
# MQTT_USERNAME=YOUR_CLOUD_MQTT_USERNAME
# MQTT_PASSWORD=YOUR_CLOUD_MQTT_PASSWORD
# MQTT_REJECT_UNAUTHORIZED=true

# Fixed node locations for the dashboard map.
# Replace lat/lng with the deployment area.
NODE_LOCATIONS_JSON={"node_01":{"name":"Node 01","lat":25.0173,"lng":121.5398,"radius_m":80}}

# Optional. If omitted, the backend stores data at ../data/smokelens.sqlite.
# DB_PATH=../data/smokelens.sqlite
